@model IEnumerable<GiveAID.Models.HelpItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Help Centre & FAQs";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Help Centre & FAQ Management</h4>
        <p class="text-muted small mb-0">Create, edit, and organize user guidance and frequently asked questions.</p>
    </div>
    <a asp-action="CreateHelpItem" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add FAQ
    </a>
</div>

<div class="card admin-table-card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th style="width: 70px;">Order</th>
                    <th>Question</th>
                    <th>Category</th>
                    <th>Answer Preview</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var faq in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">#@faq.DisplayOrder</td>
                        <td>
                            <strong class="text-dark">@faq.Question</strong>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@faq.Category</span></td>
                        <td class="small text-muted text-truncate" style="max-width: 300px;">@faq.Answer</td>
                        <td>
                            @if (faq.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditHelpItem" asp-route-id="@faq.Id" class="btn btn-sm btn-light border rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-action="DeleteHelpItem" asp-route-id="@faq.Id" method="post" class="d-inline delete-confirm-form" data-item-name="@faq.Question">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
