@model IEnumerable<GiveAID.Models.GalleryItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Gallery";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Field Gallery Assets</h4>
        <p class="text-muted small mb-0">Upload field photography, assign categories, and organize photo albums.</p>
    </div>
    <a asp-action="CreateGalleryItem" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
        <i class="bi bi-upload me-1"></i> Upload Photo
    </a>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-images text-muted" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-2">No Gallery Photos Yet</h5>
            <a asp-action="CreateGalleryItem" class="btn btn-primary rounded-pill mt-2">Upload First Photo</a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div style="height: 180px; overflow: hidden; background: #000;">
                        <img src="@item.ImageUrl" alt="@item.Title" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1542810634-71277d95dcbb?w=400&auto=format&fit=crop&q=80';">
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-secondary-subtle text-secondary small">@item.Category</span>
                            <small class="text-muted">#@item.DisplayOrder</small>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 text-truncate">@item.Title</h6>
                        <p class="small text-muted mb-3 text-truncate">@(item.Description ?? "No description")</p>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success small">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger small">Hidden</span>
                            }
                            <div class="d-flex gap-1">
                                <a asp-action="EditGalleryItem" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteGalleryItem" asp-route-id="@item.Id" method="post" class="d-inline delete-confirm-form" data-item-name="@item.Title">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
