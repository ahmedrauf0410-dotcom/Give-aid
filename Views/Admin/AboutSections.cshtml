@model IEnumerable<GiveAID.Models.AboutSection>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage About Us Sections";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">About Us Content Management</h4>
        <p class="text-muted small mb-0">
            Edit content for each of the 7 core subsections. Any update saved here immediately syncs with the public <code>/About</code> page.
        </p>
    </div>
    <a asp-controller="User" asp-action="About" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
        <i class="bi bi-box-arrow-up-right me-1"></i> Preview /About Page
    </a>
</div>

<div class="card admin-table-card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 px-4">
        <h6 class="fw-bold mb-0">All 7 Database-Driven About Subsections</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th style="width: 80px;">Order</th>
                    <th>Section Identifier</th>
                    <th>Public Section Title</th>
                    <th>Subtitle</th>
                    <th>Status</th>
                    <th>Last Updated</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sec in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">#@sec.DisplayOrder</td>
                        <td>
                            <span class="badge bg-dark-subtle text-dark font-monospace">@sec.SectionKey</span>
                        </td>
                        <td>
                            <strong class="text-dark">@sec.Title</strong>
                        </td>
                        <td class="text-muted small text-truncate" style="max-width: 250px;">
                            @(sec.Subtitle ?? "None")
                        </td>
                        <td>
                            @if (sec.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </td>
                        <td class="small text-muted">@sec.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="EditAboutSection" asp-route-id="@sec.Id" class="btn btn-sm btn-primary rounded-pill px-3">
                                <i class="bi bi-pencil-square me-1"></i> Edit Content
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
