@model GiveAID.ViewModels.AboutSectionEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Edit About Section - {Model.Title}";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary font-monospace px-3 py-1 rounded-pill mb-1">Key: @Model.SectionKey</span>
                    <h3 class="fw-bold text-dark mb-0">Edit: @Model.Title</h3>
                    <small class="text-muted">Changes saved here will immediately show up on the public <code>/About</code> page.</small>
                </div>
                <a asp-action="AboutSections" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Sections List
                </a>
            </div>

            <form asp-action="EditAboutSection" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="SectionKey" />
                <input type="hidden" asp-for="ExistingImageUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Title" class="form-control form-control-lg" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control form-control-lg" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subtitle" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Subtitle" class="form-control" />
                        <span asp-validation-for="Subtitle" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Content" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="Content" rows="7" class="form-control"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                        <small class="text-muted">Detailed description text for this subsection.</small>
                    </div>

                    <!-- Image Section -->
                    <div class="col-12 pt-3 border-top">
                        <label class="form-label small fw-semibold text-secondary">Section Image</label>
                        <div class="row align-items-center g-3">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                {
                                    <div class="border rounded-3 p-2 bg-light text-center">
                                        <img src="@Model.ExistingImageUrl" alt="Current image" class="img-fluid rounded-2" style="max-height: 140px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=300&auto=format&fit=crop&q=80';">
                                        <div class="small text-muted mt-1">Current Image</div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <label asp-for="ImageFile" class="form-label small text-muted">Upload New Image (JPG, PNG, WEBP max 5MB)</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                                <small class="text-muted">Leave empty to keep the existing image.</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">Active & Visible on Public Site</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Changes to Database
                        </button>
                        <a asp-action="AboutSections" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
