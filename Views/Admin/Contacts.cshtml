@model IEnumerable<GiveAID.Models.ContactMessage>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact Messages";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Public Inquiries & Contact Messages</h4>
        <p class="text-muted small mb-0">Review communications submitted through the Contact Us form.</p>
    </div>
</div>

<div class="card admin-table-card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Sender</th>
                    <th>Subject</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No contact messages received yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var msg in Model)
                    {
                        <tr class="@(msg.IsRead ? "" : "table-light fw-semibold")">
                            <td>
                                <strong class="text-dark d-block">@msg.Name</strong>
                                <small class="text-muted">@msg.Email</small>
                            </td>
                            <td>@msg.Subject</td>
                            <td>@(msg.Phone ?? "N/A")</td>
                            <td>
                                @if (msg.IsRead)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary text-white">Unread</span>
                                }
                            </td>
                            <td class="small text-muted">@msg.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="ContactDetails" asp-route-id="@msg.Id" class="btn btn-sm btn-light border rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Read
                                    </a>
                                    <form asp-action="DeleteContact" asp-route-id="@msg.Id" method="post" class="d-inline delete-confirm-form" data-item-name="message from @msg.Name">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
