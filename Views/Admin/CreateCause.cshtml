@model GiveAID.ViewModels.CauseEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create New Donation Cause";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Create Welfare Cause</h3>
                    <small class="text-muted">Fill in the campaign details and fundraising target</small>
                </div>
                <a asp-action="Causes" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Causes
                </a>
            </div>

            <form asp-action="CreateCause" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Children Nutrition Drive" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Category" class="form-select form-select-lg">
                            <option value="Children">Children</option>
                            <option value="Education">Education</option>
                            <option value="Disability">Disability</option>
                            <option value="Women">Women</option>
                            <option value="Youth">Youth</option>
                            <option value="Elderly">Elderly</option>
                            <option value="Healthcare">Healthcare</option>
                            <option value="Relief">Emergency Relief</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TargetAmount" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white">$</span>
                            <input asp-for="TargetAmount" type="number" step="0.01" class="form-control" placeholder="50000.00" />
                        </div>
                        <span asp-validation-for="TargetAmount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RaisedAmount" class="form-label small fw-semibold text-secondary">Initial Raised Amount ($)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white">$</span>
                            <input asp-for="RaisedAmount" type="number" step="0.01" class="form-control" value="0.00" />
                        </div>
                        <span asp-validation-for="RaisedAmount" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="ShortDescription" rows="2" class="form-control" placeholder="Brief 1-2 sentence overview for cards"></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FullDescription" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="FullDescription" rows="6" class="form-control" placeholder="Detailed story, impact metrics, and mission breakdown"></textarea>
                        <span asp-validation-for="FullDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label small fw-semibold text-secondary">Campaign Banner Image (JPG, PNG, WEBP)</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">Active & Open for Donations</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save & Publish Cause
                        </button>
                        <a asp-action="Causes" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
