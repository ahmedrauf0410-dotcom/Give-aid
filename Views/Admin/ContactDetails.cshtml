@model GiveAID.Models.ContactMessage
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Message: {Model.Subject}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Message from @Model.Name</h3>
                    <small class="text-muted">Sent on @Model.CreatedAt.ToString("f")</small>
                </div>
                <a asp-action="Contacts" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Messages
                </a>
            </div>

            <div class="p-3 bg-light rounded-3 border mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-6">
                        <span class="text-muted">Sender Name:</span>
                        <strong class="text-dark d-block">@Model.Name</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted">Email Address:</span>
                        <a href="mailto:@Model.Email" class="text-primary fw-bold d-block">@Model.Email</a>
                    </div>
                    <div class="col-sm-6 mt-2">
                        <span class="text-muted">Telephone:</span>
                        <strong class="text-dark d-block">@(Model.Phone ?? "Not provided")</strong>
                    </div>
                    <div class="col-sm-6 mt-2">
                        <span class="text-muted">Received At:</span>
                        <strong class="text-dark d-block">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</strong>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold text-dark mb-2">Subject: @Model.Subject</h5>
            <div class="p-4 bg-white border rounded-4 text-secondary mb-4 fs-6 lh-base">
                @Html.Raw(Model.Message.Replace("\n", "<br/>"))
            </div>

            <div class="d-flex flex-wrap justify-content-between gap-2 pt-3 border-top">
                <a href="mailto:@Model.Email?subject=Re: @Model.Subject" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-reply-fill me-1"></i> Email Reply Directly
                </a>

                <form asp-action="DeleteContact" asp-route-id="@Model.Id" method="post" class="d-inline delete-confirm-form" data-item-name="this message">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-trash me-1"></i> Delete Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
