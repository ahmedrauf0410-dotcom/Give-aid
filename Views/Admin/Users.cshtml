@model IEnumerable<GiveAID.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Registered Community Members";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Registered Community Members</h4>
        <p class="text-muted small mb-0">View registered donors, volunteers, toggle accounts, and inspect giving histories.</p>
    </div>
</div>

<div class="card admin-table-card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Member</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th>Profession</th>
                    <th>Donations</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No registered community members yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model)
                    {
                        var totalGiven = u.Donations.Where(d => d.PaymentStatus == "Successful").Sum(d => d.Amount);

                        <tr>
                            <td>
                                <div class="min-w-0">
                                    <strong class="text-dark d-block text-truncate" style="max-width: 140px;">@u.FullName</strong>
                                    <small class="text-muted small">ID: #@u.Id</small>
                                </div>
                            </td>
                            <td>
                                <div class="min-w-0"><a href="mailto:@u.Email" class="text-primary text-decoration-none text-truncate d-block" style="max-width: 140px;">@u.Email</a></div>
                                <small class="text-muted small">@(u.Phone ?? "No phone")</small>
                            </td>
                            <td>
                                <div>@(u.City ?? "N/A")</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 120px;">@(u.Address ?? "")</small>
                            </td>
                            <td>@(u.Profession ?? "N/A")</td>
                            <td>
                                <span class="badge bg-success-subtle text-success fw-bold">
                                    $@totalGiven.ToString("N0") (@u.Donations.Count)
                                </span>
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">Deactivated</span>
                                }
                            </td>
                            <td class="small text-muted">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="UserDetails" asp-route-id="@u.Id" class="btn btn-sm btn-light border rounded-pill px-3">
                                        <i class="bi bi-person me-1"></i> Profile
                                    </a>

                                    <form asp-action="ToggleUserStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-2" title="@(u.IsActive ? "Deactivate User" : "Activate User")">
                                            <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
