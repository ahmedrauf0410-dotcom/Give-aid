@model GiveAID.ViewModels.GalleryItemEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Upload Field Photo";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Upload Photo to Gallery</h3>
                    <small class="text-muted">Select image file, title, and programmatic category</small>
                </div>
                <a asp-action="Gallery" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Gallery
                </a>
            </div>

            <form asp-action="CreateGalleryItem" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Clean Water Ribbon Cutting Ceremony" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Category" class="form-select">
                            <option value="Children">Children Welfare</option>
                            <option value="Education">Education</option>
                            <option value="Healthcare">Healthcare & Mobile Clinics</option>
                            <option value="Water">Clean Water & Sanitations</option>
                            <option value="Women">Women Empowerment</option>
                            <option value="Relief">Emergency Relief</option>
                            <option value="General">General Activities</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Caption or context behind this moment..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label small fw-semibold text-secondary">Select Image File (JPG, PNG, WEBP max 5MB)</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">Active & Displayed on Public Website</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-upload me-1"></i> Upload Photo
                        </button>
                        <a asp-action="Gallery" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
