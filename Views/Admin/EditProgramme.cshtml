@model GiveAID.ViewModels.ProgrammeEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Edit Programme - {Model.Title}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Edit Programme: @Model.Title</h3>
                    <small class="text-muted">Update event dates, venue, or participation details</small>
                </div>
                <a asp-action="Programmes" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Programmes
                </a>
            </div>

            <form asp-action="EditProgramme" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingImageUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Title" class="form-control form-control-lg" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Category" class="form-control form-control-lg" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Upcoming">Upcoming</option>
                            <option value="Ongoing">Ongoing</option>
                            <option value="Completed">Completed</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Location" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="ShortDescription" rows="2" class="form-control"></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FullDescription" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="FullDescription" rows="6" class="form-control"></textarea>
                        <span asp-validation-for="FullDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12 pt-3 border-top">
                        <label class="form-label small fw-semibold text-secondary">Programme Banner</label>
                        <div class="row align-items-center g-3">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                {
                                    <div class="border rounded-3 p-2 bg-light text-center">
                                        <img src="@Model.ExistingImageUrl" alt="Current banner" class="img-fluid rounded-2" style="max-height: 120px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1593113598332-cd288d649433?w=300&auto=format&fit=crop&q=80';">
                                        <div class="small text-muted mt-1">Current Banner</div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <label asp-for="ImageFile" class="form-label small text-muted">Upload New Image (Leave empty to keep current)</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">Active & Listed Publicly</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-save me-1"></i> Update Programme
                        </button>
                        <a asp-action="Programmes" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
