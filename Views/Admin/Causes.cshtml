@model IEnumerable<GiveAID.Models.DonationCause>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Donation Causes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Donation Causes Management</h4>
        <p class="text-muted small mb-0">Add, edit, deactivate, or review welfare causes and campaign funds.</p>
    </div>
    <a asp-action="CreateCause" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Cause
    </a>
</div>

<div class="card admin-table-card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Cause</th>
                    <th>Category</th>
                    <th>Target</th>
                    <th>Raised</th>
                    <th>Progress</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cause in Model)
                {
                    var percent = cause.TargetAmount > 0 ? (int)((cause.RaisedAmount / cause.TargetAmount) * 100) : 0;
                    if (percent > 100) percent = 100;

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@cause.ImageUrl" alt="@cause.Name" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=100&auto=format&fit=crop&q=80';">
                                <div>
                                    <strong class="text-dark d-block">@cause.Name</strong>
                                    <small class="text-muted">@cause.Donations.Count Donations Recorded</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@cause.Category</span></td>
                        <td class="fw-semibold text-secondary">$@cause.TargetAmount.ToString("N2")</td>
                        <td class="fw-bold text-success">$@cause.RaisedAmount.ToString("N2")</td>
                        <td style="width: 150px;">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>@percent%</span>
                            </div>
                            <div class="progress custom-progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%"></div>
                            </div>
                        </td>
                        <td>
                            @if (cause.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditCause" asp-route-id="@cause.Id" class="btn btn-sm btn-light border rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                
                                <form asp-action="ToggleCauseStatus" asp-route-id="@cause.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(cause.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-2" title="@(cause.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(cause.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </form>

                                <form asp-action="DeleteCause" asp-route-id="@cause.Id" method="post" class="d-inline delete-confirm-form" data-item-name="@cause.Name">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
