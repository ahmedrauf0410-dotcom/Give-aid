@model GiveAID.ViewModels.PartnerEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add New NGO Partner";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Add NGO / Corporate Partner</h3>
                    <small class="text-muted">Register a philanthropic partner to feature on Give-AID</small>
                </div>
                <a asp-action="Partners" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Partners
                </a>
            </div>

            <form asp-action="CreatePartner" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Global Water Foundation" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control form-control-lg" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Category" class="form-select">
                            <option value="Corporate">Corporate CSR</option>
                            <option value="Foundation">Philanthropic Foundation</option>
                            <option value="NGO">Humanitarian NGO</option>
                            <option value="Academic">Academic & Research</option>
                            <option value="Government">Civic Agency</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="WebsiteUrl" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="WebsiteUrl" type="url" class="form-control" placeholder="https://example.org" />
                        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the collaboration, resources shared, or grant partnership..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="LogoFile" class="form-label small fw-semibold text-secondary">Partner Logo (Optional - JPG, PNG, WEBP)</label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">Active & Displayed on Public Website</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Partner
                        </button>
                        <a asp-action="Partners" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
