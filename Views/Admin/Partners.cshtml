@model IEnumerable<GiveAID.Models.Partner>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Partners";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-1">Our Partners Management</h4>
        <p class="text-muted small mb-0">Manage corporate, NGO, foundation, and academic partners.</p>
    </div>
    <a asp-action="CreatePartner" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Partner
    </a>
</div>

<div class="card admin-table-card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th style="width: 70px;">Order</th>
                    <th>Partner Name</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Website</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var partner in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">#@partner.DisplayOrder</td>
                        <td>
                            <strong class="text-dark">@partner.Name</strong>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@partner.Category</span></td>
                        <td class="small text-muted text-truncate" style="max-width: 180px;">@partner.Description</td>
                        <td>
                            @if (!string.IsNullOrEmpty(partner.WebsiteUrl))
                            {
                                <a href="@partner.WebsiteUrl" target="_blank" class="small text-primary text-decoration-none">
                                    Visit <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">None</span>
                            }
                        </td>
                        <td>
                            @if (partner.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditPartner" asp-route-id="@partner.Id" class="btn btn-sm btn-light border rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-action="DeletePartner" asp-route-id="@partner.Id" method="post" class="d-inline delete-confirm-form" data-item-name="@partner.Name">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
