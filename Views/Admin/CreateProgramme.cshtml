@model GiveAID.ViewModels.ProgrammeEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create New Programme";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Create Welfare Programme</h3>
                    <small class="text-muted">Schedule an initiative, event, or community outreach drive</small>
                </div>
                <a asp-action="Programmes" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Back to Programmes
                </a>
            </div>

            <form asp-action="CreateProgramme" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Free Dental & Health Clinic" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Category" class="form-control form-control-lg" placeholder="e.g. Healthcare, Relief" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Upcoming">Upcoming</option>
                            <option value="Ongoing">Ongoing</option>
                            <option value="Completed">Completed</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Location" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Location" class="form-control" placeholder="Physical address or facility venue" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="ShortDescription" rows="2" class="form-control" placeholder="Brief summary for cards"></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FullDescription" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="FullDescription" rows="6" class="form-control" placeholder="Comprehensive itinerary, volunteering expectations, and logistical notes"></textarea>
                        <span asp-validation-for="FullDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label small fw-semibold text-secondary">Programme Banner (JPG, PNG, WEBP)</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                            <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">Active & Listed Publicly</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-calendar-plus me-1"></i> Publish Programme
                        </button>
                        <a asp-action="Programmes" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
