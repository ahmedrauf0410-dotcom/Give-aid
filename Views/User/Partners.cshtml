@model IEnumerable<GiveAID.Models.Partner>
@{
    ViewData["Title"] = "Our Strategic Partners - Collaborative Impact";
}

<div class="bg-primary text-white py-5 text-center">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">United in Service</span>
        <h1 class="display-4 fw-bold font-heading mb-2">Our NGO & Corporate Partners</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 650px;">
            We collaborate with foundations, healthcare networks, tech innovators, and financial institutions to multiply our humanitarian reach.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        @foreach (var partner in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card partner-card h-100 shadow-sm border-0 p-3 p-sm-4 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-light p-2 rounded-3 border d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="bi bi-building fs-3 text-primary"></i>
                        </div>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary small mb-1">@partner.Category</span>
                            <h5 class="fw-bold text-dark mb-0">@partner.Name</h5>
                        </div>
                    </div>

                    <p class="text-muted small flex-grow-1">
                        @partner.Description
                    </p>

                    <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="text-success small fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Active Alliance</span>
                        @if (!string.IsNullOrEmpty(partner.WebsiteUrl))
                        {
                            <a href="@partner.WebsiteUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                Visit Partner <i class="bi bi-box-arrow-up-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Partnership Call to Action -->
    <div class="card bg-light border rounded-4 p-3 p-sm-4 p-md-5 mt-5 text-center">
        <h3 class="fw-bold text-dark mb-2">Interested in Becoming an Official Give-AID Partner?</h3>
        <p class="text-muted mx-auto mb-4" style="max-width: 600px;">
            We invite foundations, corporations with CSR initiatives, and academic institutions to join hands with us.
        </p>
        <div>
            <a asp-controller="User" asp-action="Contact" class="btn btn-primary btn-lg rounded-pill px-4 px-md-5 fw-semibold shadow-sm text-wrap">
                <i class="bi bi-handshake me-1"></i> Connect With Our Partnerships Desk
            </a>
        </div>
    </div>
</div>
