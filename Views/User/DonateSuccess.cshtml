@model GiveAID.ViewModels.DonationReceiptViewModel
@{
    ViewData["Title"] = "Donation Receipt - Thank You!";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-3 p-sm-4 p-md-5">
                
                <!-- Receipt Header -->
                <div class="text-center mb-4">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                        <i class="bi bi-check-lg" style="font-size: 2.5rem;"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Simulated Transaction Complete</span>
                    <h2 class="display-6 fw-bold text-dark">Thank You for Your Generosity!</h2>
                    <p class="text-muted">
                        Your simulated donation has been recorded in the Give-AID database. A formal receipt summary is provided below for your records.
                    </p>
                </div>

                <!-- Receipt Box -->
                <div class="bg-light p-3 p-sm-4 rounded-4 border mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 border-bottom mb-3">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Transaction Reference</span>
                            <div class="fs-5 fw-bold text-primary font-monospace">@Model.TransactionReference</div>
                        </div>
                        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i>@Model.PaymentStatus
                        </span>
                    </div>

                    <div class="row g-3 small">
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Supported Cause:</span>
                            <strong class="text-dark fs-6">@Model.CauseName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Donation Amount:</span>
                            <strong class="text-success fs-5">$@Model.Amount.ToString("N2") USD</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Donor Name:</span>
                            <strong class="text-dark">@Model.DonorName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Donor Email:</span>
                            <strong class="text-dark">@Model.DonorEmail</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Payment Method:</span>
                            <strong class="text-dark"><i class="bi bi-credit-card me-1"></i>Card ending in @Model.MaskedCardNumber.Substring(Model.MaskedCardNumber.Length - 4)</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Date & Time:</span>
                            <strong class="text-dark">@Model.DonationDate.ToString("f")</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="col-12 pt-2 border-top">
                                <span class="text-muted d-block">Personal Message / Dedication:</span>
                                <span class="text-secondary italic">"@Model.Notes"</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="window.print();">
                        <i class="bi bi-printer me-1"></i> Print Receipt
                    </button>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="User" asp-action="Causes" class="btn btn-outline-primary rounded-pill px-3 px-sm-4">
                            Explore More Causes
                        </a>
                        <a asp-controller="User" asp-action="Index" class="btn btn-primary rounded-pill px-3 px-sm-4">
                            Return Home
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
