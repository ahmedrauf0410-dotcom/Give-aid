@model GiveAID.ViewModels.DonateViewModel
@{
    ViewData["Title"] = "Make a Donation - Support Give-AID";
}

<div class="bg-primary text-white py-5 text-center position-relative">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">Simulated Secure Checkout</span>
        <h1 class="display-4 fw-bold font-heading mb-2">Support Give-AID Welfare Programs</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 650px;">
            Every single gift provides nutrition, healthcare, and education to vulnerable communities.
        </p>
    </div>
</div>

<div class="container py-4 py-md-5">
    
    <!-- Demonstration Notice Alert -->
    <div class="alert alert-warning border-warning d-flex align-items-center gap-3 p-3 rounded-4 shadow-sm mb-4 mb-md-5" role="alert">
        <i class="bi bi-info-circle-fill fs-2 text-warning flex-shrink-0"></i>
        <div>
            <strong>Demonstration & Dummy Payment Simulation:</strong>
            <p class="mb-0 small">
                This website uses a dummy credit card simulation to demonstrate the complete donation and database audit lifecycle. Real card charges do NOT occur, and CVV/full card numbers are never stored in the database.
            </p>
        </div>
    </div>

    <form asp-action="Donate" method="post" id="donationForm">
        @Html.AntiForgeryToken()
        
        <div class="row g-4 g-lg-5">
            <!-- Left Column: Cause & Amount & Donor Info -->
            <div class="col-lg-7">
                
                <!-- 1. Cause Selection -->
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">1</span>
                        Choose A Campaign Cause
                    </h5>
                    
                    <div class="mb-2">
                        <select asp-for="DonationCauseId" class="form-select form-select-lg fs-6" id="causeSelect">
                            @foreach (var c in Model.AvailableCauses)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.DonationCauseId ? "selected" : null)">
                                    @c.Name (@c.Category)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="DonationCauseId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- 2. Donation Amount -->
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">2</span>
                        Select Donation Amount
                    </h5>

                    <div class="row g-2 mb-3">
                        <div class="col-4 col-sm-2">
                            <button type="button" class="btn donation-preset-btn w-100 px-1 @(Model.Amount == 25 ? "active" : "")" data-amount="25">$25</button>
                        </div>
                        <div class="col-4 col-sm-2">
                            <button type="button" class="btn donation-preset-btn w-100 px-1 @(Model.Amount == 50 ? "active" : "")" data-amount="50">$50</button>
                        </div>
                        <div class="col-4 col-sm-2">
                            <button type="button" class="btn donation-preset-btn w-100 px-1 @(Model.Amount == 100 ? "active" : "")" data-amount="100">$100</button>
                        </div>
                        <div class="col-4 col-sm-2">
                            <button type="button" class="btn donation-preset-btn w-100 px-1 @(Model.Amount == 250 ? "active" : "")" data-amount="250">$250</button>
                        </div>
                        <div class="col-4 col-sm-2">
                            <button type="button" class="btn donation-preset-btn w-100 px-1 @(Model.Amount == 500 ? "active" : "")" data-amount="500">$500</button>
                        </div>
                        <div class="col-4 col-sm-2">
                            <button type="button" class="btn donation-preset-btn w-100 px-1" data-amount="custom">Custom</button>
                        </div>
                    </div>

                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white fw-bold">$</span>
                        <input asp-for="Amount" type="number" step="0.01" min="1" max="100000" class="form-control fw-bold fs-4 text-primary" id="donationAmountInput" placeholder="Enter Amount" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <!-- 3. Donor Information -->
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">3</span>
                        Donor Information
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DonorName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="DonorName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="DonorName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DonorEmail" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="DonorEmail" type="email" class="form-control" placeholder="john.doe@example.com" />
                            <span asp-validation-for="DonorEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DonorPhone" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="DonorPhone" class="form-control" placeholder="+1 (555) 000-0000" />
                            <span asp-validation-for="DonorPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Notes" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Notes" class="form-control" placeholder="Dedication or notes (optional)" />
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Interactive Card Payment Simulation -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 sticky-top" style="top: 80px;">
                    <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">4</span>
                        Payment Simulation Details
                    </h5>

                    <!-- Virtual Card Preview Graphic -->
                    <div class="card-simulation-box mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 mb-sm-4">
                            <div class="card-chip"></div>
                            <span class="badge bg-warning text-dark fw-bold">DEMO CARD</span>
                        </div>
                        <div class="font-monospace letter-spacing mb-3" id="cardPreviewNumber">
                            **** **** **** ****
                        </div>
                        <div class="d-flex justify-content-between align-items-end gap-2">
                            <div class="min-w-0 flex-grow-1">
                                <small class="text-white-50 text-uppercase d-block" style="font-size: 0.65rem;">Cardholder</small>
                                <span class="fw-bold text-truncate d-block" style="max-width: 140px;" id="cardPreviewName">@(string.IsNullOrEmpty(Model.CardHolderName) ? "CARDHOLDER NAME" : Model.CardHolderName.ToUpper())</span>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <small class="text-white-50 text-uppercase d-block" style="font-size: 0.65rem;">Expires</small>
                                <span class="fw-bold" id="cardPreviewExpiry">@(string.IsNullOrEmpty(Model.ExpiryMonth) ? "MM/YY" : $"{Model.ExpiryMonth}/{Model.ExpiryYear}")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Form Inputs -->
                    <div class="mb-3">
                        <label asp-for="CardHolderName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CardHolderName" class="form-control" placeholder="NAME AS SHOWN ON CARD" />
                        <span asp-validation-for="CardHolderName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CardNumber" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-credit-card text-muted"></i></span>
                            <input asp-for="CardNumber" class="form-control font-monospace" placeholder="4532 0159 8832 4242" maxlength="19" />
                        </div>
                        <span asp-validation-for="CardNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-4">
                            <label asp-for="ExpiryMonth" class="form-label small fw-semibold text-secondary">Month</label>
                            <input asp-for="ExpiryMonth" class="form-control text-center px-1" placeholder="MM" maxlength="2" />
                            <span asp-validation-for="ExpiryMonth" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="ExpiryYear" class="form-label small fw-semibold text-secondary">Year</label>
                            <input asp-for="ExpiryYear" class="form-control text-center px-1" placeholder="YYYY" maxlength="4" />
                            <span asp-validation-for="ExpiryYear" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="CVV" class="form-label small fw-semibold text-secondary">CVV</label>
                            <input asp-for="CVV" type="password" class="form-control text-center font-monospace px-1" placeholder="123" maxlength="4" />
                            <span asp-validation-for="CVV" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning btn-lg w-100 py-3 fw-bold rounded-pill text-dark shadow-sm">
                        <i class="bi bi-lock-fill me-1"></i> Process Simulated Donation
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        <i class="bi bi-shield-check text-success me-1"></i> 256-Bit SSL Encrypted &bull; No CVV Stored
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
