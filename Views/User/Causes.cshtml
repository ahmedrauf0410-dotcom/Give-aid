@model IEnumerable<GiveAID.Models.DonationCause>
@{
    ViewData["Title"] = "Welfare Causes - Support Our Campaigns";
    var selectedCategory = ViewBag.SelectedCategory as string ?? "All";
    var categories = ViewBag.Categories as IEnumerable<string> ?? new List<string>();
}

<div class="bg-primary text-white py-5 text-center">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">Impact Through Giving</span>
        <h1 class="display-4 fw-bold font-heading mb-2">Our Welfare Campaigns</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 650px;">
            Choose a cause close to your heart. Every single donation is tracked with utmost transparency and deployed directly to programmatic relief.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Category Filter Tabs -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a asp-action="Causes" asp-route-category="All" class="btn @(selectedCategory == "All" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4">
            All Causes
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Causes" asp-route-category="@cat" class="btn @(selectedCategory == cat ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4">
                @cat
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
            <h4 class="fw-bold mt-3">No Causes Found</h4>
            <p class="text-muted">There are currently no active causes in this category.</p>
            <a asp-action="Causes" class="btn btn-outline-primary rounded-pill mt-2">View All Causes</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cause in Model)
            {
                var percent = cause.TargetAmount > 0 ? (int)((cause.RaisedAmount / cause.TargetAmount) * 100) : 0;
                if (percent > 100) percent = 100;

                <div class="col-lg-4 col-md-6">
                    <div class="card cause-card h-100 shadow-sm border-0">
                        <div class="cause-image-wrapper">
                            <span class="cause-category-badge">@cause.Category</span>
                            <img src="@cause.ImageUrl" alt="@cause.Name" onerror="this.src='https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&auto=format&fit=crop&q=80';">
                        </div>
                        <div class="card-body p-3 p-sm-4 d-flex flex-column">
                            <h5 class="fw-bold text-dark mb-2">
                                <a asp-action="CauseDetails" asp-route-id="@cause.Id" class="text-dark text-decoration-none">
                                    @cause.Name
                                </a>
                            </h5>
                            <p class="text-muted small flex-grow-1">
                                @cause.ShortDescription
                            </p>

                            <!-- Progress Bar -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small fw-bold mb-1">
                                    <span class="text-success">$@cause.RaisedAmount.ToString("N0") Raised</span>
                                    <span class="text-secondary">$@cause.TargetAmount.ToString("N0") Goal</span>
                                </div>
                                <div class="progress custom-progress mb-2">
                                    <div class="progress-bar" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>@cause.Donations.Count Donations</span>
                                    <span>@percent% Funded</span>
                                </div>
                            </div>

                            <div class="row g-2 mt-3 pt-3 border-top">
                                <div class="col-6">
                                    <a asp-action="CauseDetails" asp-route-id="@cause.Id" class="btn btn-outline-secondary w-100 rounded-pill small fw-semibold">
                                        Details
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a asp-action="Donate" asp-route-causeId="@cause.Id" class="btn btn-primary w-100 rounded-pill small fw-bold">
                                        Donate
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
