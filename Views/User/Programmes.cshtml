@model IEnumerable<GiveAID.Models.Programme>
@{
    ViewData["Title"] = "Programmes & Community Welfare";
    var selectedCategory = ViewBag.SelectedCategory as string ?? "All";
    var categories = ViewBag.Categories as IEnumerable<string> ?? new List<string>();
}

<div class="bg-primary text-white py-5 text-center">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">Join Our Hands</span>
        <h1 class="display-4 fw-bold font-heading mb-2">NGO Programmes & Field Events</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 650px;">
            Participate in upcoming medical camps, youth workshops, clean water installations, and food drives.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Categories -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a asp-action="Programmes" asp-route-category="All" class="btn @(selectedCategory == "All" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4">
            All Programmes
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Programmes" asp-route-category="@cat" class="btn @(selectedCategory == cat ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4">
                @cat
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
            <h4 class="fw-bold mt-3">No Programmes Scheduled</h4>
            <p class="text-muted">There are no active programmes matching this category at present.</p>
            <a asp-action="Programmes" class="btn btn-outline-primary rounded-pill mt-2">View All Programmes</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var prog in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card programme-card h-100 shadow-sm border-0">
                        <div class="cause-image-wrapper">
                            <span class="cause-category-badge bg-info text-dark fw-bold">@prog.Category</span>
                            <img src="@prog.ImageUrl" alt="@prog.Title" onerror="this.src='https://images.unsplash.com/photo-1593113598332-cd288d649433?w=600&auto=format&fit=crop&q=80';">
                        </div>
                        <div class="card-body p-3 p-sm-4 d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span>@prog.EventDate.ToString("MMM dd, yyyy")</span>
                                <span>&bull;</span>
                                <i class="bi bi-geo-alt text-danger"></i>
                                <span class="text-truncate">@prog.Location</span>
                            </div>

                            <h5 class="fw-bold text-dark mb-2">
                                <a asp-action="ProgrammeDetails" asp-route-id="@prog.Id" class="text-dark text-decoration-none hover-primary">
                                    @prog.Title
                                </a>
                            </h5>

                            <p class="text-muted small flex-grow-1">
                                @prog.ShortDescription
                            </p>

                            <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success">@prog.Status</span>
                                <a asp-action="ProgrammeDetails" asp-route-id="@prog.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                    I'm Interested / Details &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
