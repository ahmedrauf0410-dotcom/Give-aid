@model GiveAID.ViewModels.HelpCentreViewModel
@{
    ViewData["Title"] = "Help Centre & FAQs - Give-AID";
}

<div class="bg-primary text-white py-5 text-center">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">Knowledge Base & FAQs</span>
        <h1 class="display-4 fw-bold font-heading mb-2">Help Centre & Guidance</h1>
        <p class="lead text-white-50 mx-auto mb-4" style="max-width: 650px;">
            Find immediate answers regarding donation verification, participating in programmes, tax certificates, and account management.
        </p>

        <!-- Search Bar -->
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <form asp-action="HelpCentre" method="get" class="d-flex flex-column flex-sm-row gap-2">
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-lg rounded-pill px-4 shadow-sm" placeholder="Search questions, keywords (e.g. tax, card, rsvp)..." />
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm text-nowrap">
                        <i class="bi bi-search"></i> Search
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Category Tabs -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a asp-action="HelpCentre" asp-route-category="All" asp-route-search="@Model.SearchTerm" class="btn @(Model.SelectedCategory == "All" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4">
            All Questions
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-action="HelpCentre" asp-route-category="@cat" asp-route-search="@Model.SearchTerm" class="btn @(Model.SelectedCategory == cat ? "btn-primary" : "btn-outline-secondary") rounded-pill px-4">
                @cat
            </a>
        }
    </div>

    @if (!Model.FAQs.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-question-circle text-muted" style="font-size: 3rem;"></i>
            <h4 class="fw-bold mt-3">No Help Articles Found</h4>
            <p class="text-muted">We couldn't find any questions matching your search terms.</p>
            <a asp-action="HelpCentre" class="btn btn-outline-primary rounded-pill mt-2">View All FAQs</a>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <!-- FAQ Accordion -->
                <div class="accordion shadow-sm rounded-4 overflow-hidden" id="helpAccordion">
                    @{ int index = 0; }
                    @foreach (var item in Model.FAQs)
                    {
                        var isFirst = index == 0;
                        <div class="accordion-item border-0 border-bottom">
                            <h2 class="accordion-header" id="heading-@item.Id">
                                <button class="accordion-button @(isFirst ? "" : "collapsed") py-3 px-3 px-sm-4 fw-bold text-dark fs-6" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="collapse-@item.Id">
                                    <span class="badge bg-secondary-subtle text-secondary me-3 small">@item.Category</span>
                                    @item.Question
                                </button>
                            </h2>
                            <div id="collapse-@item.Id" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="heading-@item.Id" data-bs-parent="#helpAccordion">
                                <div class="accordion-body px-3 px-sm-4 py-3 text-secondary fs-6 lh-base">
                                    @Html.Raw(item.Answer.Replace("\n", "<br/>"))
                                </div>
                            </div>
                        </div>
                        index++;
                    }
                </div>
            </div>
        </div>
    }

    <!-- Quick Help Cards -->
    <div class="row g-4 mt-5 pt-3">
        <div class="col-md-4">
            <div class="card p-3 p-sm-4 border rounded-4 text-center h-100 shadow-sm">
                <i class="bi bi-chat-dots-fill fs-1 text-primary mb-2"></i>
                <h5 class="fw-bold">Member Queries Desk</h5>
                <p class="text-muted small">Registered members can raise customized queries and track answers directly.</p>
                <a asp-controller="User" asp-action="Queries" class="btn btn-outline-primary rounded-pill mt-auto">Open Query &rarr;</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 p-sm-4 border rounded-4 text-center h-100 shadow-sm">
                <i class="bi bi-person-plus-fill fs-1 text-success mb-2"></i>
                <h5 class="fw-bold">Invite Friends</h5>
                <p class="text-muted small">Invite friends and family to join our community and support life-changing causes.</p>
                <a asp-controller="User" asp-action="InviteFriends" class="btn btn-outline-success rounded-pill mt-auto">Invite Friends &rarr;</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 p-sm-4 border rounded-4 text-center h-100 shadow-sm">
                <i class="bi bi-telephone-fill fs-1 text-warning mb-2"></i>
                <h5 class="fw-bold">Contact Support</h5>
                <p class="text-muted small">Still need personalized help? Reach our operational staff via email or telephone.</p>
                <a asp-controller="User" asp-action="Contact" class="btn btn-outline-warning text-dark rounded-pill mt-auto">Contact Us &rarr;</a>
            </div>
        </div>
    </div>
</div>
