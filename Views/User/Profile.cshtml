@model GiveAID.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Member Profile - Give-AID";
    var totalDonated = Model.Donations.Where(d => d.PaymentStatus == "Successful").Sum(d => d.Amount);
}

<div class="bg-primary text-white py-5">
    <div class="container py-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 72px; height: 72px;">
                    @(string.IsNullOrEmpty(Model.User.FullName) ? "U" : Model.User.FullName.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <h2 class="fw-bold mb-1 font-heading text-white">@Model.User.FullName</h2>
                    <div class="text-white-50 small">
                        <i class="bi bi-envelope me-1"></i>@Model.User.Email &bull; <i class="bi bi-geo-alt me-1"></i>@Model.User.City
                    </div>
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold fs-6">
                    <i class="bi bi-star-fill me-1"></i>Active Community Member
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Stat Strip -->
    <div class="row g-3 g-md-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4 text-center">
                <div class="text-success fs-1 mb-1"><i class="bi bi-cash-stack"></i></div>
                <h3 class="fw-bold text-dark mb-0">$@totalDonated.ToString("N2")</h3>
                <small class="text-muted text-uppercase fw-semibold">Total Contributions</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4 text-center">
                <div class="text-primary fs-1 mb-1"><i class="bi bi-calendar2-check"></i></div>
                <h3 class="fw-bold text-dark mb-0">@Model.ProgrammeInterests.Count()</h3>
                <small class="text-muted text-uppercase fw-semibold">Programmes RSVP'd</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4 text-center">
                <div class="text-info fs-1 mb-1"><i class="bi bi-chat-square-dots"></i></div>
                <h3 class="fw-bold text-dark mb-0">@Model.Queries.Count()</h3>
                <small class="text-muted text-uppercase fw-semibold">Support Queries</small>
            </div>
        </div>
    </div>

    <!-- Details and Giving History Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="profileTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="donations-tab" data-bs-toggle="pill" data-bs-target="#donations" type="button" role="tab">
                <i class="bi bi-cash me-1"></i> Donation History
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="programmes-tab" data-bs-toggle="pill" data-bs-target="#programmes" type="button" role="tab">
                <i class="bi bi-calendar-event me-1"></i> Event RSVPs
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="profile-info-tab" data-bs-toggle="pill" data-bs-target="#profile-info" type="button" role="tab">
                <i class="bi bi-person-lines-fill me-1"></i> Account Details
            </button>
        </li>
    </ul>

    <div class="tab-content" id="profileTabContent">
        <!-- 1. Donations History -->
        <div class="tab-pane fade show active" id="donations" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0">My Giving Contributions</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ref #</th>
                                <th>Cause</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Card Ending</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Donations.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">You haven't made any donations yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var d in Model.Donations)
                                {
                                    <tr>
                                        <td class="font-monospace fw-semibold text-primary">@d.TransactionReference</td>
                                        <td><strong>@d.DonationCause.Name</strong></td>
                                        <td class="fw-bold text-success">$@d.Amount.ToString("N2")</td>
                                        <td>@d.DonationDate.ToString("MMM dd, yyyy")</td>
                                        <td class="font-monospace">...@d.MaskedCardNumber.Substring(d.MaskedCardNumber.Length - 4)</td>
                                        <td><span class="badge bg-success">@d.PaymentStatus</span></td>
                                        <td>
                                            <a asp-action="DonateSuccess" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                                Receipt
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. Event RSVPs -->
        <div class="tab-pane fade" id="programmes" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0">My Programme Registrations</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Programme</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Registered On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ProgrammeInterests.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">You have not registered for any programmes yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.ProgrammeInterests)
                                {
                                    <tr>
                                        <td><strong>@r.Programme.Title</strong></td>
                                        <td>@r.Programme.EventDate.ToString("MMM dd, yyyy")</td>
                                        <td>@r.Programme.Location</td>
                                        <td>@r.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a asp-action="ProgrammeDetails" asp-route-id="@r.ProgrammeId" class="btn btn-sm btn-outline-primary rounded-pill">
                                                View Event
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. Account Details -->
        <div class="tab-pane fade" id="profile-info" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4">
                <h5 class="fw-bold mb-4">Personal Details</h5>
                <div class="row g-4">
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">Full Name</small>
                        <strong class="fs-6">@Model.User.FullName</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">Email Address</small>
                        <strong class="fs-6">@Model.User.Email</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">Phone Number</small>
                        <strong class="fs-6">@(Model.User.Phone ?? "Not provided")</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">Profession</small>
                        <strong class="fs-6">@(Model.User.Profession ?? "Not specified")</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">City</small>
                        <strong class="fs-6">@(Model.User.City ?? "Not provided")</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">Street Address</small>
                        <strong class="fs-6">@(Model.User.Address ?? "Not provided")</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-semibold d-block">Member Since</small>
                        <strong class="fs-6">@Model.User.CreatedAt.ToString("MMMM dd, yyyy")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
