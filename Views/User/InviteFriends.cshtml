@model GiveAID.ViewModels.InviteViewModel
@{
    ViewData["Title"] = "Invite Friends - Spread Give-AID";
}

<div class="bg-primary text-white py-5 text-center">
    <div class="container py-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">Grow Our Community</span>
        <h1 class="display-4 fw-bold font-heading mb-2">Invite Your Friends & Colleagues</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 650px;">
            Introduce people you care about to Give-AID. When compassionate hearts join forces, no humanitarian challenge is insurmountable.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-people-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Send A Digital Invitation</h3>
                    <p class="text-muted small">
                        In this local/demo environment, invitations are securely stored in the Give-AID database and logged for administrative and outreach review.
                    </p>
                </div>

                <form asp-action="InviteFriends" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SenderName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="SenderName" class="form-control py-2" placeholder="Your Full Name" />
                            <span asp-validation-for="SenderName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FriendName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FriendName" class="form-control py-2" placeholder="Friend's Full Name" />
                            <span asp-validation-for="FriendName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="FriendEmail" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FriendEmail" type="email" class="form-control py-2" placeholder="friend.email@example.com" />
                            <span asp-validation-for="FriendEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PersonalMessage" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="PersonalMessage" rows="4" class="form-control" placeholder="Hi! I recently found Give-AID, a verified NGO delivering clean water and child healthcare. Take a look at their inspiring programs!"></textarea>
                            <span asp-validation-for="PersonalMessage" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 text-center">
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Send Digital Invitation
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
