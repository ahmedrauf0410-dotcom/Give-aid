@{
    ViewData["Title"] = "Access Restricted - Give-AID";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 my-5">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold text-dark">Access Restricted</h3>
                <p class="text-muted mt-2">
                    You do not possess the required permissions or administrator privileges to view this resource.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                    <a asp-controller="User" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                    <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-shield-lock me-1"></i> Admin Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
