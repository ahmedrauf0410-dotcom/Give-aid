@model GiveAID.ViewModels.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Portal Login - Give-AID";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-3 p-sm-4 p-md-5 my-4 bg-white border-top border-5 border-danger">
                
                <div class="text-center mb-4">
                    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1 font-heading">Admin Console</h3>
                    <p class="text-muted small">Authorized personnel & content management access only</p>
                </div>

                <form asp-action="AdminLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person-badge text-muted"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="admin" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary">Keep admin session active</label>
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg w-100 py-3 fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-shield-check me-1"></i> Authenticate Administrator
                    </button>
                </form>

            
                <div class="text-center mt-3 small">
                    <a asp-controller="User" asp-action="Index" class="text-secondary text-decoration-none">
                        &larr; Return to Public Website
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
