@model GiveAID.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register as a Community Member - Give-AID";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 p-3 p-sm-4 p-md-5 my-3">
                
                <div class="text-center mb-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1 font-heading">Join The Give-AID Movement</h3>
                    <p class="text-muted small">Register an account to track your donations, RSVP to events, and submit inquiries</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Eleanor Vance" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="eleanor@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Phone" type="tel" class="form-control" placeholder="+1 (555) 234-5678" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profession" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Profession" class="form-control" placeholder="e.g. Teacher, Nurse, Architect" />
                            <span asp-validation-for="Profession" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Address" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Address" class="form-control" placeholder="456 Oak Avenue" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="City" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="City" class="form-control" placeholder="e.g. Springfield" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Complete Member Registration
                            </button>
                        </div>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-muted">
                    Already a registered member? 
                    <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign In Here</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
