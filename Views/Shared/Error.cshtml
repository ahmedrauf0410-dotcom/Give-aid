@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm p-4 my-5">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-octagon" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-dark">An Unexpected Error Occurred</h2>
                <p class="text-muted mt-2">
                    We apologize for the inconvenience. Our technical administration team has been notified. Please try again or return to the homepage.
                </p>
                <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="User" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                    <a asp-controller="User" asp-action="Contact" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="bi bi-envelope me-1"></i> Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
