@inject GiveAID.Services.ISiteSettingService SiteSettingsService
@{
    var site = await SiteSettingsService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | @site.NgoName</title>

    <!-- Google Fonts & Bootstrap 5.3 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Admin Styles -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        /* Immediate fallback for fixed sidebar & zero sliders */
        .admin-sidebar {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            bottom: 0 !important;
            width: 270px !important;
            height: 100vh !important;
            z-index: 1040 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
        }
        .admin-sidebar::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        @@media (min-width: 992px) {
            #page-content-wrapper {
                margin-left: 270px !important;
                width: calc(100% - 270px) !important;
            }
            #wrapper.toggled .admin-sidebar {
                transform: translateX(-100%) !important;
            }
            #wrapper.toggled #page-content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            #wrapper.toggled .admin-sidebar {
                transform: translateX(0) !important;
            }
            #page-content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }
    </style>
</head>
<body class="bg-light">

    <!-- Admin Wrapper -->
    <div id="wrapper">
        
        <!-- Mobile Sidebar Backdrop Overlay -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Sidebar (Off-canvas drawer on mobile < 992px, sticky on desktop) -->
        <div class="admin-sidebar" id="sidebar-wrapper">
            <div class="sidebar-heading px-3 py-3 border-bottom d-flex align-items-center justify-content-between">
                <a asp-controller="Admin" asp-action="Dashboard" class="text-white text-decoration-none d-flex align-items-center gap-2">
                    <div class="bg-teal text-white rounded-3 p-1 d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; background-color: var(--admin-primary);">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-6 lh-1 font-heading text-white">@site.NgoName</div>
                        <small class="text-white-50" style="font-size: 0.68rem; letter-spacing: 0.05em;">ADMIN CONSOLE</small>
                    </div>
                </a>
            </div>

            <div class="list-group list-group-flush py-2">
                <a asp-controller="Admin" asp-action="Dashboard" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-speedometer2 me-2 text-info"></i> <span>Dashboard</span>
                </a>

                <div class="sidebar-section-title px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold">Content Management</div>
                
                <a asp-controller="Admin" asp-action="AboutSections" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-journal-text me-2 text-warning"></i> <span>About Us Sections</span>
                </a>
                <a asp-controller="Admin" asp-action="Causes" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-heart-pulse me-2 text-danger"></i> <span>Donation Causes</span>
                </a>
                <a asp-controller="Admin" asp-action="Programmes" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-calendar-event me-2 text-info"></i> <span>Programmes</span>
                </a>
                <a asp-controller="Admin" asp-action="Partners" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-building me-2 text-success"></i> <span>Our Partners</span>
                </a>
                <a asp-controller="Admin" asp-action="Gallery" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-images me-2 text-warning"></i> <span>Photo Gallery</span>
                </a>
                <a asp-controller="Admin" asp-action="HelpCentre" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-question-circle me-2 text-info"></i> <span>Help Centre / FAQs</span>
                </a>

                <div class="sidebar-section-title px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold">Donations & Users</div>

                <a asp-controller="Admin" asp-action="Donations" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-cash-stack me-2 text-success"></i> <span>All Donations</span>
                </a>
                <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-people me-2 text-primary"></i> <span>Registered Members</span>
                </a>
                <a asp-controller="Admin" asp-action="ProgrammeInterests" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-ticket-perforated me-2 text-warning"></i> <span>Programme RSVPs</span>
                </a>

                <div class="sidebar-section-title px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold">Communication & Support</div>

                <a asp-controller="Admin" asp-action="Queries" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-chat-dots me-2 text-info"></i> <span>User Queries</span>
                </a>
                <a asp-controller="Admin" asp-action="Contacts" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-envelope me-2 text-danger"></i> <span>Contact Messages</span>
                </a>
                <a asp-controller="Admin" asp-action="Invitations" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-send me-2 text-light"></i> <span>Member Invitations</span>
                </a>

                <div class="sidebar-section-title px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold">Settings</div>

                <a asp-controller="Admin" asp-action="SiteSettings" class="list-group-item list-group-item-action bg-transparent text-white-50 py-2 px-3">
                    <i class="bi bi-gear me-2 text-light"></i> <span>Site Settings</span>
                </a>
            </div>

            <div class="p-3 mt-auto border-top border-secondary border-opacity-25">
                <a asp-controller="User" asp-action="Index" target="_blank" class="btn btn-outline-light btn-sm w-100 mb-2 rounded-pill">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Public Website
                </a>
                <form asp-controller="Account" asp-action="AdminLogout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                        <i class="bi bi-power me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column">
            
            <!-- Top Nav -->
            <nav class="navbar navbar-light bg-white border-bottom py-2 py-md-3 px-3 px-md-4 shadow-sm sticky-top">
                <div class="d-flex align-items-center justify-content-between w-100 gap-2">
                    <div class="d-flex align-items-center gap-2 gap-md-3 min-w-0">
                        <button class="btn btn-sm btn-light border" id="sidebarToggle" title="Toggle Navigation Menu">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h5 class="mb-0 fw-bold text-dark text-truncate" style="font-size: clamp(1rem, 2.5vw, 1.25rem);">@ViewData["Title"]</h5>
                    </div>

                    <div class="d-flex align-items-center gap-2 gap-md-3 flex-shrink-0">
                        <a asp-controller="User" asp-action="Index" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-2 px-md-3">
                            <i class="bi bi-eye"></i> <span class="d-none d-sm-inline ms-1">Public Site</span>
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle rounded-pill px-2 px-md-3 py-1 border d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <div class="bg-teal text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; font-size: 0.75rem; background-color: var(--admin-primary);">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="small fw-semibold d-none d-md-inline">@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="SiteSettings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="AdminLogout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Alerts -->
            <div class="container-fluid px-3 px-md-4 pt-3">
                <partial name="_AlertMessages" />
            </div>

            <!-- Content Area -->
            <div class="container-fluid px-3 px-md-4 py-3 flex-grow-1">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-3 px-md-4 text-muted small mt-auto">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>&copy; @DateTime.UtcNow.Year @site.NgoName Admin System. Version 1.0</span>
                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>System Online</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
